{
  "name": "codex-asset-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Local stdio MCP server that lets Claude dispatch, track and approve Codex art tasks (ADR-0009).",
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "node dist/src/server.js",
    "probe": "node scripts/probe-tools.mjs",
    "deploy": "npm run build && node scripts/deploy.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@openai/codex-sdk": "0.164.0",
    "pngjs": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pngjs": "6.0.5",
    "typescript": "7.0.2"
  }
}
