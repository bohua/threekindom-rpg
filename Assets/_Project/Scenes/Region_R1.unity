  m_Script: {fileID: 11500000, guid: eb67f606bcac4b64f8e126da86b4d5f6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ThreeKingdoms.Gameplay::ThreeKingdoms.Gameplay.RegionTalk
  Entries:
  - from: 4
    until: 0
    speaker: "\u675C\u5173\u540F"
    lines:
    - "\u7AD9\u4F4F\u3002\u5C45\u5EB8\u5173\u4EE5\u5317\u662F\u4E0A\u8C37\uFF0C\u5173\u5916\u4E4C\u6853\u3001\u9C9C\u5351\u6E38\u9A91\u51FA\u6CA1\uFF0C\u8FB9\u585E\u6212\u4E25\u3002"
    - "\u6CA1\u6709\u5DDE\u91CC\u7684\u51FA\u585E\u6587\u4E66\uFF0C\u8C01\u4E5F\u4E0D\u653E\u3002\u5218\u4F7F\u541B\u53D1\u7684\u6587\u4E66\uFF0C\u6211\u8FD9\u513F\u4E00\u5E74\u4E5F\u89C1\u4E0D\u5230\u51E0\u5F20\u3002"
    - "\u4F60\u95EE\u5173\u5916\uFF1F\u8349\u957F\u8D77\u6765\u7684\u65F6\u5019\uFF0C\u9A6C\u8E44\u58F0\u80FD\u4F20\u5341\u91CC\u3002\u542C\u89C1\u4E86\uFF0C\u5C31\u5F97\u70B9\u70FD\u706B\u3002"
    keys:
    - dlg.lb1.npc.r1.juyong.official.N4.1
    - dlg.lb1.npc.r1.juyong.official.N4.2
    - dlg.lb1.npc.r1.juyong.official.N4.3
  - from: 6
    until: 0
    speaker: "\u675C\u5173\u540F"
    lines:
    - "\u5362\u5C1A\u4E66\u5728\u4E0A\u8C37\u8FC7\u4E16\uFF0C\u4ED6\u5BB6\u91CC\u4EBA\u60F3\u51FA\u5173\u6536\u6B93\uFF0C\u6211\u4E5F\u6CA1\u653E\u3002\u2026\u2026\u4EE4\u5C31\u662F\u4EE4\u3002"
    keys:
    - dlg.lb1.npc.r1.juyong.official.N6.1
  - from: 7
    until: 0
    speaker: "\u675C\u5173\u540F"
    lines:
    - "\u5DDE\u91CC\u6362\u4E86\u4E3B\u4EBA\uFF0C\u51FA\u585E\u4EE4\u8FD8\u662F\u90A3\u9053\u4EE4\u3002\u5173\uFF0C\u4E0D\u4F1A\u4E3A\u8C01\u5F00\u3002"
    keys:
    - dlg.lb1.npc.r1.juyong.official.N7.1
  Body: {fileID: 1747926978}
  Radius: 4.5
  BubbleHeight: 3.2
